# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/workflo

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# Session Security (Generate a strong 32+ char secret in production)
SESSION_SECRET=super_secret_session_key_change_in_production_min_32_chars

# Google OAuth (Optional in early dev, required for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Logging
LOG_LEVEL=info
